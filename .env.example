# --- Paperless-Verbindung -------------------------------------------------
# Internal address under which the container reaches Paperless
PAPERLESS_URL=http://paperless-webserver:8000
# API-Token: Paperless > Profil (oben rechts) > API-Auth-Token
PAPERLESS_TOKEN=hier-token-einfuegen
# Public address for "open document" links in the browser
PAPERLESS_PUBLIC_URL=https://paperless.example.ch
# Only if Paperless rejects the internal address (error 400 "Bad Request", PAPERLESS_ALLOWED_HOSTS):
# Host name that Paperless allows, e.g. paperless.example.com
PAPERLESS_HOST_HEADER=
# Set to false for a self-signed certificate
PAPERLESS_VERIFY_SSL=true
# Optional: API-Version fixieren (leer = Paperless-Standard)
PAPERLESS_API_VERSION=

# --- Budget ---------------------------------------------------------------
# Name of the custom field (type currency/monetary) holding the amount
AMOUNT_FIELD_NAME=Total
CURRENCY=EUR

# --- Reconciliation with bank statements -----------------------------------
# Defaults are the German names (kept for existing installations); for a fresh English setup use e.g.
# PAID_TAG_NAME=paid, PAID_FIELD_NAME=Paid on, ORDER_TAG_NAME=Order
PAID_TAG_NAME=bezahlt
# Tag for order confirmations (noted until the invoice or debit arrives)
ORDER_TAG_NAME=Bestellung
# Invoice or debit is expected this many days after the order
ORDER_EXPECT_DAYS=30
PAID_FIELD_NAME=Bezahlt am

# --- Traccar (kilometres per vehicle) ---------------------------------------
# Address of the Traccar server (in the same Docker network e.g. http://traccar:8082)
TRACCAR_URL=
# Entweder Token (Traccar > Einstellungen > Konto > Token) ...
TRACCAR_TOKEN=
# ... or user/password
TRACCAR_USER=
TRACCAR_PASSWORD=
TRACCAR_VERIFY_SSL=true

# --- Access protection (optional, recommended if not behind an NPM access list) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Meters (optional): Home Assistant as a source for meter readings -----
# Langlebiges Zugangs-Token: Home Assistant > Profil > Sicherheit > Langlebige Zugangs-Token
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
# Read meters automatically this often (minutes)
METER_POLL_MINUTES=60

# --- Bank connections via Open Banking (Enable Banking, free for personal use) ---------
# 1. Create an account and an application at https://enablebanking.com (control panel), choose "restricted production"
#    (your own accounts only), let it generate the private key and download it.
# 2. Save the private key as data/enablebanking.pem (the data/ folder is not committed) and enter the application id:
ENABLEBANKING_APP_ID=
# Optional: where the key lives inside the container (default: /data/enablebanking.pem)
ENABLEBANKING_KEY_FILE=
# Redirect URL registered for the application. Default: <address you open the app on>/api/openbanking/callback
ENABLEBANKING_REDIRECT_URL=
# Countries whose banks are offered (Revolut customers may be listed under LT or IE)
ENABLEBANKING_COUNTRIES=BE,LT,IE
# Fetch new transactions this often (hours); banks allow only ~4 unattended requests per account and day
BANK_SYNC_HOURS=8
